{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://<your-railway-backend-url>/api/:path*"
    }
  ],
  "env": {
    "VITE_API_URL": "https://<your-railway-backend-url>"
  }
}
